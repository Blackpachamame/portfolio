# Keep source files in LF, including Windows checkouts.
*.astro text eol=lf
*.ts text eol=lf
*.mts text eol=lf
*.cts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.css text eol=lf

# Keep these repository rules in LF too.
/.gitattributes text eol=lf
/.editorconfig text eol=lf

# Images and fonts used by this project must not undergo text conversion.
*.ico binary
*.png binary
*.webp binary
*.woff2 binary
