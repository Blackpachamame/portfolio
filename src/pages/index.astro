---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="mx-auto flex min-h-screen max-w-6xl items-center px-6 py-20">
    <section>
      <p class="mb-4 text-sm font-medium tracking-widest text-neutral-400 uppercase">
        Frontend Developer
      </p>

      <h1 class="max-w-4xl text-5xl font-semibold tracking-tight sm:text-7xl">
        Marcos Andrés Travaglini
      </h1>

      <p class="mt-6 max-w-2xl text-lg leading-8 text-neutral-300">
        Desarrollo interfaces web responsivas y productos digitales con React, TypeScript y
        tecnologías modernas de frontend.
      </p>
    </section>
  </main>
</Layout>
