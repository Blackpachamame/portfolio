---
import { headerContent, siteInfo } from '../../data/site';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner container">
    <p class="site-footer__identity">
      <span>{siteInfo.name}</span>
      <span>{headerContent.descriptor}</span>
    </p>
    <p class="site-footer__build">Astro · TypeScript · Tailwind CSS</p>
    <p class="site-footer__year">© {currentYear}</p>
  </div>
</footer>
