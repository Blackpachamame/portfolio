---
import { Image } from 'astro:assets';

import logo from '../../assets/logoLight.png';
import { headerContent, navigationLinks, socialLinks } from '../../data/site';
---

<header class="site-header">
  <div class="site-header__inner container">
    <a class="site-header__brand" href="#inicio">
      <Image class="site-header__logo" src={logo} alt="" width={56} height={56} loading="eager" />
      <span class="site-header__identity">
        <span>{headerContent.shortName}</span>
        <span>{headerContent.descriptor}</span>
      </span>
    </a>

    <nav class="site-header__nav" aria-label="Navegación principal">
      <ul class="site-header__navigation" role="list">
        {
          navigationLinks.map((link) => (
            <li>
              <a
                class={link.href === '#contacto' ? 'site-header__contact-link' : undefined}
                href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__season">
      <label class="visually-hidden" for="season-selector">Estación</label>
      <select class="site-header__season-select" id="season-selector" data-season-selector>
        <option value="default">Predeterminado</option>
        <option value="autumn">Otoño</option>
        <option value="spring">Primavera</option>
        <option value="summer">Verano</option>
        <option value="winter">Invierno</option>
      </select>
    </div>

    <ul class="site-header__social" aria-label="Redes profesionales" role="list">
      {
        socialLinks.map((link) => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${link.label} (se abre en una nueva pestaña)`}>
              {link.platform}
              <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script is:inline>
  const seasonSelector = document.querySelector('[data-season-selector]');

  if (seasonSelector instanceof HTMLSelectElement) {
    const currentSeason = document.documentElement.dataset.season;
    seasonSelector.value =
      currentSeason === 'autumn' ||
      currentSeason === 'spring' ||
      currentSeason === 'summer' ||
      currentSeason === 'winter'
        ? currentSeason
        : 'default';

    seasonSelector.addEventListener('change', () => {
      const selectedSeason = seasonSelector.value;
      const season =
        selectedSeason === 'autumn' ||
        selectedSeason === 'spring' ||
        selectedSeason === 'summer' ||
        selectedSeason === 'winter'
          ? selectedSeason
          : 'default';
      document.documentElement.dataset.season = season;

      try {
        localStorage.setItem('portfolio-season', season);
      } catch {}
    });
  }
</script>
