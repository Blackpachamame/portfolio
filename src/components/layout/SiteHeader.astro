---
import defaultIcon from '../../assets/icons/icon-default.webp';
import autumnIcon from '../../assets/icons/icon-autumn.webp';
import springIcon from '../../assets/icons/icon-spring.webp';
import summerIcon from '../../assets/icons/icon-summer.webp';
import winterIcon from '../../assets/icons/icon-winter.webp';
import type { Season } from '../../data/seasons';
import { headerContent, navigationLinks, socialLinks } from '../../data/site';

type SeasonMode = 'auto' | Season;

interface SeasonOption {
  value: SeasonMode;
  label: string;
  icon: string;
}

const seasons: readonly SeasonOption[] = [
  { value: 'auto', label: 'Automático', icon: defaultIcon.src },
  { value: 'spring', label: 'Primavera', icon: springIcon.src },
  { value: 'summer', label: 'Verano', icon: summerIcon.src },
  { value: 'autumn', label: 'Otoño', icon: autumnIcon.src },
  { value: 'winter', label: 'Invierno', icon: winterIcon.src },
];
---

<header class="site-header" data-at-hero>
  <div class="site-header__inner container">
    <a class="site-header__brand" href="#inicio">
      <span class="site-header__logo" aria-hidden="true"></span>
      <span class="site-header__identity">
        <span>{headerContent.shortName}</span>
        <span>{headerContent.descriptor}</span>
      </span>
    </a>

    <nav class="site-header__nav" aria-label="Navegación principal">
      <ul class="site-header__navigation" role="list">
        {
          navigationLinks.map((link) => (
            <li>
              <a
                class={link.href === '#contacto' ? 'site-header__contact-link' : undefined}
                href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__season" data-season-control hidden>
      <span class="visually-hidden" id="season-label">Estación</span>
      <!-- Keep the existing value/change contract with the Hero and ambient effects. -->
      <select id="season-selector" data-season-selector aria-labelledby="season-label" hidden>
        {
          seasons
            .filter((season) => season.value !== 'auto')
            .map((season) => <option value={season.value}>{season.label}</option>)
        }
      </select>
      <button
        class="site-header__season-trigger"
        id="season-trigger"
        type="button"
        role="combobox"
        aria-labelledby="season-label"
        aria-haspopup="listbox"
        aria-expanded="false"
        aria-controls="season-options"
        data-season-trigger>
        <img
          class="site-header__season-icon"
          data-season-icon
          src={defaultIcon.src}
          width="16"
          height="16"
          alt=""
          aria-hidden="true"
        />
        <span data-season-value>{seasons[0].label}</span>
        <span class="site-header__season-chevron" aria-hidden="true"></span>
      </button>
      <ul
        class="site-header__season-options"
        id="season-options"
        role="listbox"
        aria-labelledby="season-label"
        data-season-options
        aria-hidden="true"
        inert
        hidden>
        {
          seasons.map((season) => (
            <li
              class="site-header__season-option"
              id={'season-option-' + season.value}
              role="option"
              aria-selected={season.value === 'auto' ? 'true' : 'false'}
              data-season-option={season.value}
              data-icon={season.icon}
              data-label={season.label}>
              <img
                class="site-header__season-icon"
                src={season.icon}
                width="16"
                height="16"
                alt=""
                aria-hidden="true"
              />
              <span>{season.label}</span>
              <span class="site-header__season-check" aria-hidden="true" />
            </li>
          ))
        }
      </ul>
    </div>

    <ul class="site-header__social" aria-label="Redes profesionales" role="list">
      {
        socialLinks.map((link) => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${link.label} (se abre en una nueva pestaña)`}>
              {link.platform}
              <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  import { isSeasonMode } from '../../data/seasons';
  import { mountSeasonState } from '../../scripts/watercolor/season-state';

  function initializeSeasonDropdown() {
    const control = document.querySelector<HTMLElement>('[data-season-control]');
    const selector = control?.querySelector<HTMLSelectElement>('[data-season-selector]');
    const trigger = control?.querySelector<HTMLButtonElement>('[data-season-trigger]');
    const panel = control?.querySelector<HTMLUListElement>('[data-season-options]');
    const icon = trigger?.querySelector<HTMLImageElement>('[data-season-icon]');
    const label = trigger?.querySelector<HTMLElement>('[data-season-value]');
    if (!control || !selector || !trigger || !panel || !icon || !label) return;

    const options = Array.from(panel.querySelectorAll<HTMLLIElement>('[data-season-option]'));
    if (!options.length) return;
    const controller = mountSeasonState();
    if (!controller) return;
    const enabled = (option: HTMLLIElement) => {
      const value = option.dataset.seasonOption;
      return isSeasonMode(value) && controller.canSelect(value);
    };
    const selectedIndex = () =>
      Math.max(
        0,
        options.findIndex((option) => option.dataset.seasonOption === controller.state().mode),
      );
    let activeIndex = selectedIndex();
    let searchText = '';
    let lastTypedAt = 0;
    let visibilityVersion = 0;

    const isOpen = () => trigger.getAttribute('aria-expanded') === 'true';

    const updateSelection = () => {
      const selected = options[selectedIndex()];
      selector.value = controller.state().destination;
      label.textContent = selected.dataset.label ?? '';
      if (selected.dataset.icon) icon.src = selected.dataset.icon;
      options.forEach((option) => {
        option.setAttribute('aria-selected', String(option === selected));
        option.setAttribute('aria-disabled', String(!enabled(option)));
      });
      if (isOpen() && !enabled(options[activeIndex])) setActiveOption(selectedIndex());
    };

    const setActiveOption = (index: number) => {
      const option = options[index];
      if (!option || !enabled(option)) return;
      activeIndex = index;
      options.forEach((option, optionIndex) => {
        option.toggleAttribute('data-active', optionIndex === activeIndex);
      });
      trigger.setAttribute('aria-activedescendant', option.id);
      option.scrollIntoView({ block: 'nearest', behavior: 'instant' });
    };

    const edge = (step: number) =>
      step > 0
        ? options.findIndex(enabled)
        : options.length - 1 - [...options].reverse().findIndex(enabled);

    const moveActive = (step: number) => {
      for (let next = activeIndex + step; options[next]; next += step) {
        if (!enabled(options[next])) continue;
        setActiveOption(next);
        break;
      }
    };

    const openDropdown = (index = selectedIndex()) => {
      visibilityVersion += 1;
      searchText = '';
      trigger.focus({ preventScroll: true });
      const wasHidden = panel.hidden;
      panel.hidden = false;
      // Establish the closed style before transitioning out of display:none.
      if (wasHidden) panel.getBoundingClientRect();
      panel.inert = false;
      panel.setAttribute('aria-hidden', 'false');
      trigger.setAttribute('aria-expanded', 'true');
      setActiveOption(options[index] && enabled(options[index]) ? index : edge(1));
    };

    const closeDropdown = () => {
      if (!isOpen()) return;
      const version = ++visibilityVersion;
      trigger.setAttribute('aria-expanded', 'false');
      trigger.removeAttribute('aria-activedescendant');
      panel.inert = true;
      panel.setAttribute('aria-hidden', 'true');
      options.forEach((option) => option.removeAttribute('data-active'));
      searchText = '';

      const transitions = panel.getAnimations();
      if (!transitions.length) {
        panel.hidden = true;
        return;
      }
      // Canceled transitions also settle; a reopened panel invalidates this completion.
      void Promise.allSettled(transitions.map((transition) => transition.finished)).then(() => {
        if (version === visibilityVersion && !isOpen()) panel.hidden = true;
      });
    };

    const commitSelection = () => {
      const value = options[activeIndex]?.dataset.seasonOption;
      closeDropdown();
      controller.choose(value);
    };

    selector.addEventListener('change', () => {
      if (!controller.choose(selector.value)) updateSelection();
    });

    const findByTyping = (key: string) => {
      if (!isOpen()) openDropdown();
      const now = Date.now();
      searchText = now - lastTypedAt > 700 ? key : searchText + key;
      lastTypedAt = now;
      const query = searchText.toLocaleLowerCase('es');
      const repeated = [...query].every((character) => character === query[0]);
      const prefix = repeated ? query[0] : query;
      const start = prefix.length === 1 ? activeIndex + 1 : activeIndex;
      for (let step = 0; step < options.length; step += 1) {
        const index = (start + step) % options.length;
        if (
          enabled(options[index]) &&
          options[index].dataset.label?.toLocaleLowerCase('es').startsWith(prefix)
        ) {
          setActiveOption(index);
          break;
        }
      }
    };

    trigger.addEventListener('click', () => {
      if (!isOpen()) openDropdown();
      else closeDropdown();
    });

    trigger.addEventListener('keydown', (event: KeyboardEvent) => {
      if (event.isComposing || event.ctrlKey || event.metaKey) return;
      switch (event.key) {
        case 'Enter':
        case ' ':
          event.preventDefault();
          if (!event.repeat) {
            if (!isOpen()) openDropdown();
            else commitSelection();
          }
          break;
        case 'ArrowDown':
          event.preventDefault();
          if (!isOpen()) openDropdown();
          else if (!event.altKey) moveActive(1);
          break;
        case 'ArrowUp':
          event.preventDefault();
          if (!isOpen()) openDropdown(edge(1));
          else if (event.altKey) commitSelection();
          else moveActive(-1);
          break;
        case 'Home':
        case 'End':
          event.preventDefault();
          if (!isOpen()) openDropdown();
          setActiveOption(edge(event.key === 'Home' ? 1 : -1));
          break;
        case 'Escape':
          if (isOpen()) {
            event.preventDefault();
            event.stopPropagation();
            closeDropdown();
          }
          break;
        case 'Tab':
          if (isOpen()) commitSelection();
          break;
        default:
          if (event.key.length === 1 && !event.altKey) {
            event.preventDefault();
            findByTyping(event.key);
          }
      }
    });

    // Keep DOM focus on the combobox; options are reached via aria-activedescendant.
    panel.addEventListener('mousedown', (event: MouseEvent) => {
      if (event.button === 0) event.preventDefault();
    });
    panel.addEventListener('click', (event: MouseEvent) => {
      if (!isOpen()) return;
      const option =
        event.target instanceof Element
          ? event.target.closest<HTMLLIElement>('[data-season-option]')
          : null;
      if (!option || !panel.contains(option) || !enabled(option)) return;
      activeIndex = options.indexOf(option);
      commitSelection();
      trigger.focus({ preventScroll: true });
    });

    document.addEventListener('pointerdown', (event: PointerEvent) => {
      if (isOpen() && event.target instanceof Node && !control.contains(event.target)) {
        commitSelection();
      }
    });
    control.addEventListener('focusout', (event: FocusEvent) => {
      if (
        isOpen() &&
        !(event.relatedTarget instanceof Node && control.contains(event.relatedTarget))
      ) {
        commitSelection();
      }
    });
    window.addEventListener('blur', closeDropdown);
    controller.subscribe(updateSelection);
    updateSelection();
    control.hidden = false;
  }

  initializeSeasonDropdown();

  const hero = document.querySelector('.hero');
  const header = document.querySelector('.site-header');
  if (hero && header) {
    new IntersectionObserver(
      ([entry]) => header.toggleAttribute('data-at-hero', entry.isIntersecting),
      { rootMargin: '-64px 0px 0px' },
    ).observe(hero);
  }
</script>
