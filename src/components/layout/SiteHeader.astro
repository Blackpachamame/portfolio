---
import { navigationLinks, siteInfo } from '../../data/site';
---

<header class="site-header">
  <div class="site-header__inner container">
    <a class="site-header__brand" href="#inicio" aria-label="Ir al inicio">
      {siteInfo.name}
    </a>

    <nav aria-label="Navegación principal">
      <ul class="site-header__navigation" role="list">
        {
          navigationLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
