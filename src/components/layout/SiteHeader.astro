---
import { Image } from 'astro:assets';

import logo from '../../assets/logoLight.png';
import { navigationLinks, siteInfo, socialLinks } from '../../data/site';
---

<header class="site-header">
  <div class="site-header__inner container">
    <a class="site-header__brand" href="#inicio" aria-label={`Ir al inicio — ${siteInfo.name}`}>
      <Image class="site-header__logo" src={logo} alt="" width={40} height={40} loading="eager" />
      <span class="site-header__identity">
        <span>Marcos T.</span>
        <span>{siteInfo.role}</span>
      </span>
    </a>

    <nav class="site-header__nav" aria-label="Navegación principal">
      <ul class="site-header__navigation" role="list">
        {
          navigationLinks.map((link) => (
            <li>
              <a
                class={link.href === '#contacto' ? 'site-header__contact-link' : undefined}
                href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ul class="site-header__social" aria-label="Redes profesionales" role="list">
      {
        socialLinks.map((link) => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${link.label} (se abre en una nueva pestaña)`}>
              {link.platform}
              <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>
