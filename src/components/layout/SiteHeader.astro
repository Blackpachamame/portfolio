---
import defaultIcon from '../../assets/icons/icon-default.webp';
import autumnIcon from '../../assets/icons/icon-autumn.webp';
import springIcon from '../../assets/icons/icon-spring.webp';
import summerIcon from '../../assets/icons/icon-summer.webp';
import winterIcon from '../../assets/icons/icon-winter.webp';
import { headerContent, navigationLinks, socialLinks } from '../../data/site';

const seasonIcons = {
  default: defaultIcon.src,
  autumn: autumnIcon.src,
  spring: springIcon.src,
  summer: summerIcon.src,
  winter: winterIcon.src,
};
---

<header class="site-header">
  <div class="site-header__inner container">
    <a class="site-header__brand" href="#inicio">
      <span class="site-header__logo" aria-hidden="true"></span>
      <span class="site-header__identity">
        <span>{headerContent.shortName}</span>
        <span>{headerContent.descriptor}</span>
      </span>
    </a>

    <nav class="site-header__nav" aria-label="Navegación principal">
      <ul class="site-header__navigation" role="list">
        {
          navigationLinks.map((link) => (
            <li>
              <a
                class={link.href === '#contacto' ? 'site-header__contact-link' : undefined}
                href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div
      class="site-header__season"
      data-season-control
      data-season-icons={JSON.stringify(seasonIcons)}
      hidden>
      <label class="visually-hidden" for="season-selector">Estación</label>
      <select class="site-header__season-select" id="season-selector" data-season-selector>
        <option value="default">Predeterminado</option>
        <option value="autumn">Otoño</option>
        <option value="spring">Primavera</option>
        <option value="summer">Verano</option>
        <option value="winter">Invierno</option>
      </select>
      <img
        class="site-header__season-icon"
        data-season-icon
        src={seasonIcons.default}
        width="16"
        height="16"
        alt=""
        aria-hidden="true"
      />
    </div>

    <ul class="site-header__social" aria-label="Redes profesionales" role="list">
      {
        socialLinks.map((link) => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${link.label} (se abre en una nueva pestaña)`}>
              {link.platform}
              <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script is:inline>
  const seasonControl = document.querySelector('[data-season-control]');
  const seasonSelector = seasonControl?.querySelector('[data-season-selector]');
  const seasonIcon = seasonControl?.querySelector('[data-season-icon]');

  if (seasonControl instanceof HTMLElement && seasonSelector instanceof HTMLSelectElement) {
    const seasonIcons = JSON.parse(seasonControl.dataset.seasonIcons ?? '{}');
    const updateSeasonIcon = () => {
      if (seasonIcon instanceof HTMLImageElement) {
        seasonIcon.src = seasonIcons[seasonSelector.value] ?? seasonIcons.default;
      }
    };

    const currentSeason = document.documentElement.dataset.season;
    seasonSelector.value =
      currentSeason === 'autumn' ||
      currentSeason === 'spring' ||
      currentSeason === 'summer' ||
      currentSeason === 'winter'
        ? currentSeason
        : 'default';
    updateSeasonIcon();
    seasonControl.hidden = false;

    seasonSelector.addEventListener('change', () => {
      updateSeasonIcon();
      const selectedSeason = seasonSelector.value;
      const season =
        selectedSeason === 'autumn' ||
        selectedSeason === 'spring' ||
        selectedSeason === 'summer' ||
        selectedSeason === 'winter'
          ? selectedSeason
          : 'default';

      try {
        localStorage.setItem('portfolio-season', season);
      } catch {}
    });
  }
</script>
