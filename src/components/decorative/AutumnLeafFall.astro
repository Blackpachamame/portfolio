---
interface Props {
  viewport?: boolean;
}

const { viewport = false } = Astro.props;
---

<template data-autumn-leaf-template data-autumn-leaf-viewport={viewport || undefined}>
  <div class="autumn-leaf-fall" aria-hidden="true" data-autumn-leaf-fall>
    <span class="autumn-leaf-fall__leaf"></span>
    <span class="autumn-leaf-fall__leaf"></span>
    <span class="autumn-leaf-fall__leaf"></span>
    <span class="autumn-leaf-fall__leaf"></span>
    <span class="autumn-leaf-fall__leaf"></span>
    <span class="autumn-leaf-fall__leaf"></span>
    <span class="autumn-leaf-fall__leaf"></span>
    <span class="autumn-leaf-fall__leaf"></span>
    <span class="autumn-leaf-fall__leaf"></span>
    <span class="autumn-leaf-fall__leaf" data-autumn-leaf-final></span>
  </div>
</template>

<script>
  const hero = document.querySelector('.hero');
  const seasonSelector = document.querySelector('[data-season-selector]');
  const botanicalReveal = document.querySelector('[data-botanical-reveal]');
  const leafTemplate = document.querySelector('[data-autumn-leaf-template]');

  if (
    hero instanceof HTMLElement &&
    seasonSelector instanceof HTMLSelectElement &&
    botanicalReveal instanceof HTMLElement &&
    leafTemplate instanceof HTMLTemplateElement
  ) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let previousSeason = document.documentElement.dataset.season ?? 'default';
    let activeEffect: HTMLElement | undefined;
    let pendingEffect = false;
    let headerObserver: ResizeObserver | undefined;

    const stopEffect = () => {
      pendingEffect = false;
      headerObserver?.disconnect();
      headerObserver = undefined;
      activeEffect?.remove();
      activeEffect = undefined;
    };

    const startEffect = () => {
      stopEffect();

      if (reducedMotion.matches) return;

      const effect = leafTemplate.content.firstElementChild?.cloneNode(true);

      if (!(effect instanceof HTMLElement)) return;

      const finalLeaf = effect.querySelector('[data-autumn-leaf-final]');

      if (!(finalLeaf instanceof HTMLElement)) return;

      activeEffect = effect;
      finalLeaf.addEventListener(
        'animationend',
        () => {
          if (activeEffect === effect) stopEffect();
        },
        { once: true },
      );
      if (leafTemplate.hasAttribute('data-autumn-leaf-viewport')) {
        effect.classList.add('autumn-leaf-fall--viewport');
        const header = document.querySelector('.site-header');

        if (header instanceof HTMLElement) {
          const updateInset = () => {
            if (activeEffect !== effect) return;
            effect.style.setProperty(
              '--autumn-header-height',
              `${header.getBoundingClientRect().height}px`,
            );
          };

          updateInset();
          headerObserver = new ResizeObserver(updateInset);
          headerObserver.observe(header);
        }

        document.body.append(effect);
      } else {
        hero.append(effect);
      }
    };

    seasonSelector.addEventListener('change', () => {
      const nextSeason = seasonSelector.value;

      if (nextSeason !== 'autumn') {
        stopEffect();
      } else if (previousSeason !== 'autumn') {
        pendingEffect =
          !reducedMotion.matches && botanicalReveal.dataset.botanicalVariant !== 'autumn';
      }

      previousSeason = nextSeason;
    });

    // This mutation is delivered after the synchronous botanical swap and ready/replay cycle.
    const botanicalObserver = new MutationObserver(() => {
      if (
        !pendingEffect ||
        reducedMotion.matches ||
        seasonSelector.value !== 'autumn' ||
        document.documentElement.dataset.season !== 'autumn' ||
        botanicalReveal.dataset.botanicalVariant !== 'autumn' ||
        !botanicalReveal.classList.contains('hero__art--botanical-ready')
      ) {
        return;
      }

      startEffect();
    });

    botanicalObserver.observe(botanicalReveal, {
      attributes: true,
      attributeFilter: ['data-botanical-variant'],
    });

    reducedMotion.addEventListener('change', (event) => {
      if (event.matches) stopEffect();
    });
  }
</script>
