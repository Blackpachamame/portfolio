    [92, 600, 750, 'M 637 209 C 639 240 643 264 607 293'],
    [122, 450, 900, 'M 860 209 C 810 262 750 281 694 292 L 605 332'],
    [112, 510, 840, 'M 845 287 C 799 332 775 356 727 366 C 696 393 662 421 641 479'],
    [108, 650, 700, 'M 806 411 C 782 473 731 541 680 562 L 618 626'],
