  <svg
    class="hero__branch hero__branch--right botanical-reveal botanical-reveal--right"
    viewBox="0 0 960 640"
    width="960"
    height="640"
    focusable="false">
    <defs>
      <mask
        id="hero-branch-mask-right"
        x="0"
        y="0"
        width="960"
        height="640"
        maskUnits="userSpaceOnUse"
        maskContentUnits="userSpaceOnUse">
        <path
          class="botanical-mask__stroke botanical-mask__stem"
          pathLength="1"
          d="M 1030 4 C 918 42 894 126 874 226 C 854 330 834 408 782 510"></path>
        <path
          class="botanical-mask__stroke botanical-mask__branch botanical-mask__branch--first"
          pathLength="1"
          d="M 962 28 C 852 58 778 72 704 116 C 636 156 584 178 500 194"></path>
