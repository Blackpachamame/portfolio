        <path
          class="botanical-mask__stroke botanical-mask__twig botanical-mask__twig--first botanical-mask__summer"
          pathLength="1"
          d="M 612 136 C 558 151 484 209 428 172 M 559 124 Q 540 103 533 94"></path>
        <path
          class="botanical-mask__stroke botanical-mask__twig botanical-mask__twig--first botanical-mask__summer"
          pathLength="1"
          d="M 810 450 C 768 469 716 480 668 507"></path>
        <path
          class="botanical-mask__stroke botanical-mask__twig botanical-mask__twig--first botanical-mask__autumn"
          pathLength="1"
          d="M 548 131 C 532 124 517 108 496 91"></path>
        <path
          class="botanical-mask__stroke botanical-mask__twig botanical-mask__twig--first botanical-mask__autumn"
          pathLength="1"
          d="M 555 323 C 538 343 518 352 496 359"></path>
        <rect class="botanical-mask__coverage" width="960" height="640" fill="white"></rect>
      </mask>
      {
        Object.entries(mobileMasks).map(([variant, paths]) => (
          <mask
            id={`hero-branch-mask-mobile-${variant}`}
            x="0"
            y="0"
            width="960"
            height="640"
            maskUnits="userSpaceOnUse"
            maskContentUnits="userSpaceOnUse">
            {paths.map(([width, start, duration, d]) => (
              <path
                class="botanical-mobile__stroke"
                pathLength="1"
                stroke-width={width}
                data-start={start}
                data-duration={duration}
                d={d}
              />
            ))}
          </mask>
        ))
      }
    </defs>

    <image
      data-botanical-image="right"
      width="960"
      height="640"
      preserveAspectRatio="xMidYMid meet"
      mask="url(#hero-branch-mask-right)"
    />
  </svg>

  <noscript>
    <img
      class="hero__branch hero__branch--left"
      src={defaultLeftBranch.src}
      width="960"
      height="640"
      alt=""
    />
    <img
      class="hero__branch hero__branch--right"
      src={defaultRightBranch.src}
      width="960"
      height="640"
      alt=""
    />
  </noscript>
</div>

<script is:inline define:vars={{ botanicalAssets }}>
  const botanicalReveal = document.querySelector('[data-botanical-reveal]');
  const seasonSelector = document.querySelector('[data-season-selector]');
  const leftBranch = botanicalReveal?.querySelector('[data-botanical-image="left"]');
  const rightBranch = botanicalReveal?.querySelector('[data-botanical-image="right"]');
  const leftReveal = leftBranch?.ownerSVGElement;

  if (
    botanicalReveal instanceof HTMLElement &&
    seasonSelector instanceof HTMLSelectElement &&
    leftBranch instanceof SVGImageElement &&
    rightBranch instanceof SVGImageElement &&
    leftReveal instanceof SVGSVGElement
  ) {
    const leftVisible = window.matchMedia('(min-width: 48rem)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const pendingImages = new Map();
    let activeVariant;
    let latestRequest = 0;
    let mobileAnimations = [];
    let mobileExit;

    const resolveVariant = () => {
      // The selector holds intent; data-season holds the appearance already applied.
      const season = seasonSelector.value;
      return season === 'autumn' ||
        season === 'spring' ||
        season === 'summer' ||
        season === 'winter'
        ? season
        : 'default';
    };

    const mobilePaths = () => [
      ...botanicalReveal.querySelectorAll(
        '#hero-branch-mask-mobile-' + activeVariant + ' .botanical-mobile__stroke',
      ),
    ];

    const stopMobileMotion = () => {
      for (const { path, animation } of mobileAnimations) {
        path.style.strokeDashoffset = getComputedStyle(path).strokeDashoffset;
        animation.cancel();
      }
      mobileAnimations = [];
    };

    const finishMobile = (visible) => {
      stopMobileMotion();
      for (const path of mobilePaths()) path.style.strokeDashoffset = visible ? '0' : '1';
      botanicalReveal.dataset.botanicalPhase = visible ? 'static' : 'swap';
      mobileExit = undefined;
    };

    const animateMobile = (enter) => {
      stopMobileMotion();
      if (reducedMotion.matches) {
        finishMobile(enter);
        return Promise.resolve();
      }
      botanicalReveal.dataset.botanicalPhase = enter ? 'enter' : 'exit';
      const target = enter ? '0' : '1';
      const batch = mobilePaths().map((path) => {
        const start = Number(path.dataset.start);
        const duration = Number(path.dataset.duration);
        const animation = path.animate(
          [
            { strokeDashoffset: getComputedStyle(path).strokeDashoffset },
            { strokeDashoffset: target },
          ],
          {
            duration: enter ? duration : (duration * 380) / 1350,
            delay: enter ? start : ((1350 - start - duration) * 380) / 1350,
            easing: 'cubic-bezier(0.4, 0, 0.2, 1)',
            fill: 'both',
          },
        );
        return { path, animation };
      });
      mobileAnimations = batch;
      return Promise.all(batch.map(({ animation }) => animation.finished.catch(() => {}))).then(
        () => {
          if (mobileAnimations !== batch) return;
          for (const { path, animation } of batch) {
            path.style.strokeDashoffset = target;
            animation.cancel();
          }
          mobileAnimations = [];
          botanicalReveal.dataset.botanicalPhase = enter ? 'static' : 'swap';
        },
      );
    };

    const useMobileMask = (variant, hidden) => {
      rightBranch.setAttribute('mask', 'url(#hero-branch-mask-mobile-' + variant + ')');
      for (const path of botanicalReveal.querySelectorAll(
        '#hero-branch-mask-mobile-' + variant + ' .botanical-mobile__stroke',
      ))
        path.style.strokeDashoffset = hidden ? '1' : '0';
    };

    const preloadImage = (src) => {
      const pending = pendingImages.get(src);
      if (pending) return pending;
      const image = new Image();
      image.src = src;
      // Retain the decoded image through an erase and any breakpoint replan.
      const decoded = image.decode().then(() => image);
      pendingImages.set(src, decoded);
      decoded.then(
        () => {
          if (!mobileExit) pendingImages.delete(src);
        },
        () => pendingImages.delete(src),
      );
      return decoded;
    };

    const applyVariant = (variant, includeLeft) => {
      const assets = botanicalAssets[variant];
      leftReveal.toggleAttribute('data-botanical-static', !includeLeft);
      if (includeLeft) {
        leftBranch.setAttribute('href', assets.left);
      } else {
        // A mobile commit must not leave the previous variant available to a later resize.
        leftBranch.removeAttribute('href');
      }
      rightBranch.setAttribute('href', assets.right);
      botanicalReveal.dataset.botanicalVariant = variant;
      document.documentElement.dataset.season = variant;
    };

    const loadVariant = async (nextVariant) => {
      const request = ++latestRequest;
      const includeLeft = leftVisible.matches;
      const assets = botanicalAssets[nextVariant];
      const completingLeft = nextVariant === activeVariant;

      if (completingLeft && (!includeLeft || leftBranch.getAttribute('href') === assets.left)) {
        // A → B → A restores the applied mask without a commit or an effect replay.
        if (!includeLeft && (mobileExit || botanicalReveal.dataset.botanicalPhase === 'swap')) {
          mobileExit = undefined;
          void animateMobile(true);
        }
        return;
      }

      const exit =
        !includeLeft && !completingLeft && activeVariant !== undefined
          ? (mobileExit ??= animateMobile(false))
          : Promise.resolve();

      try {
        await Promise.all([
          ...(completingLeft
            ? [preloadImage(assets.left)]
            : [preloadImage(assets.right), ...(includeLeft ? [preloadImage(assets.left)] : [])]),
          exit,
        ]);
      } catch {
        if (request === latestRequest && !includeLeft && activeVariant !== undefined) {
          mobileExit = undefined;
          void animateMobile(true);
        }
        return;
      }

      if (
        request !== latestRequest ||
        nextVariant !== resolveVariant() ||
        includeLeft !== leftVisible.matches
      )
        return;

      if (completingLeft) {
        // This adds an asset to the applied season, without a season commit or replay.
        leftBranch.setAttribute('href', assets.left);
        return;
      }

      const shouldReplay = activeVariant !== undefined;
      if (includeLeft) {
        rightBranch.setAttribute('mask', 'url(#hero-branch-mask-right)');
        rightBranch.ownerSVGElement.removeAttribute('data-botanical-static');
        if (shouldReplay) botanicalReveal.classList.remove('hero__art--botanical-ready');
      } else {
        // Select a completely hidden mask before assigning the decoded raster.
        stopMobileMotion();
        useMobileMask(nextVariant, !reducedMotion.matches);
      }

      applyVariant(nextVariant, includeLeft);
      activeVariant = nextVariant;
      pendingImages.delete(assets.right);
      if (includeLeft) pendingImages.delete(assets.left);
      mobileExit = undefined;

      if (includeLeft && shouldReplay) void botanicalReveal.offsetWidth;
      botanicalReveal.classList.add('hero__art--botanical-ready');
      if (!includeLeft) void animateMobile(true);
    };

    seasonSelector.addEventListener('change', () => {
      void loadVariant(resolveVariant());
    });
    leftReveal.toggleAttribute('data-botanical-static', !leftVisible.matches);

    leftVisible.addEventListener('change', () => {
      finishMobile(true);
      if (leftVisible.matches) {
        rightBranch.setAttribute('mask', 'url(#hero-branch-mask-right)');
        // Crossing the breakpoint exposes the applied branch without replaying its draw.
        rightBranch.ownerSVGElement.setAttribute('data-botanical-static', '');
      } else {
        leftReveal.setAttribute('data-botanical-static', '');
        if (activeVariant !== undefined) useMobileMask(activeVariant, false);
      }
      void loadVariant(resolveVariant());
    });

    reducedMotion.addEventListener('change', () => {
      if (reducedMotion.matches && !leftVisible.matches) {
        finishMobile(
          botanicalReveal.dataset.botanicalPhase !== 'exit' &&
            botanicalReveal.dataset.botanicalPhase !== 'swap',
        );
      }
    });

    void loadVariant(resolveVariant());
  }
</script>

<style>
  .botanical-reveal--left[data-botanical-static] .botanical-mask__stroke {
    animation: none;
    stroke-dashoffset: 0;
  }

  .botanical-reveal--left[data-botanical-static] .botanical-mask__coverage {
    animation: none;
    opacity: 1;
  }
</style>
