---
import { getImage } from 'astro:assets';

import defaultBranchLeft from '../../assets/seasonal/default/branch-left.png';
import defaultBranchRight from '../../assets/seasonal/default/branch-right.png';
import winterBranchLeft from '../../assets/seasonal/winter/branch-left.png';
import winterBranchRight from '../../assets/seasonal/winter/branch-right.png';

const [defaultLeftBranch, defaultRightBranch, winterLeftBranch, winterRightBranch] =
  await Promise.all([
    getImage({ src: defaultBranchLeft, width: 960, format: 'webp', quality: 82 }),
    getImage({ src: defaultBranchRight, width: 960, format: 'webp', quality: 82 }),
    getImage({ src: winterBranchLeft, width: 960, format: 'webp', quality: 82 }),
    getImage({ src: winterBranchRight, width: 960, format: 'webp', quality: 82 }),
  ]);

const botanicalAssets = {
  default: {
    left: defaultLeftBranch.src,
    right: defaultRightBranch.src,
  },
  winter: {
    left: winterLeftBranch.src,
    right: winterRightBranch.src,
  },
};
---

<div class="hero__art" aria-hidden="true" data-botanical-reveal>
  <svg
    class="hero__branch hero__branch--left botanical-reveal botanical-reveal--left"
    viewBox="0 0 960 640"
    width="960"
    height="640"
    focusable="false">
    <defs>
      <mask
        id="hero-branch-mask-left"
        x="0"
        y="0"
        width="960"
        height="640"
        maskUnits="userSpaceOnUse"
        maskContentUnits="userSpaceOnUse">
        <path
          class="botanical-mask__stroke botanical-mask__stem"
          pathLength="1"
          d="M -70 8 C 64 36 98 116 134 212 C 172 314 208 386 288 476"></path>
        <path
          class="botanical-mask__stroke botanical-mask__branch botanical-mask__branch--first"
          pathLength="1"
          d="M 0 32 C 116 70 210 56 310 82 C 402 106 454 148 550 176"></path>
        <path
          class="botanical-mask__stroke botanical-mask__branch botanical-mask__branch--second"
          pathLength="1"
          d="M 62 86 C 164 106 230 150 298 208 C 358 258 408 274 490 306"></path>
        <path
          class="botanical-mask__stroke botanical-mask__twig botanical-mask__twig--first"
          pathLength="1"
          d="M 112 126 C 72 220 52 294 94 374 C 120 422 162 454 228 512"></path>
        <path
          class="botanical-mask__stroke botanical-mask__twig botanical-mask__twig--second"
          pathLength="1"
          d="M 204 116 C 254 36 338 24 434 48 M 302 202 C 392 196 470 242 550 300"></path>
        <rect class="botanical-mask__coverage" width="960" height="640" fill="white"></rect>
      </mask>
    </defs>

    <image
      data-botanical-image="left"
      width="960"
      height="640"
      preserveAspectRatio="xMidYMid meet"
      mask="url(#hero-branch-mask-left)"
    />
  </svg>

  <svg
    class="hero__branch hero__branch--right botanical-reveal botanical-reveal--right"
    viewBox="0 0 960 640"
    width="960"
    height="640"
    focusable="false">
    <defs>
      <mask
        id="hero-branch-mask-right"
        x="0"
        y="0"
        width="960"
        height="640"
        maskUnits="userSpaceOnUse"
        maskContentUnits="userSpaceOnUse">
        <path
          class="botanical-mask__stroke botanical-mask__stem"
          pathLength="1"
          d="M 1030 4 C 918 42 894 126 874 226 C 854 330 834 408 782 510"></path>
        <path
          class="botanical-mask__stroke botanical-mask__branch botanical-mask__branch--first"
          pathLength="1"
          d="M 962 28 C 852 58 778 72 704 116 C 636 156 584 178 500 194"></path>
        <path
          class="botanical-mask__stroke botanical-mask__branch botanical-mask__branch--second"
          pathLength="1"
          d="M 916 92 C 820 124 758 182 710 246 C 664 304 616 342 546 386"></path>
        <path
          class="botanical-mask__stroke botanical-mask__twig botanical-mask__twig--first"
          pathLength="1"
          d="M 882 136 C 920 218 930 302 902 378 C 882 432 846 480 798 542"></path>
        <path
          class="botanical-mask__stroke botanical-mask__twig botanical-mask__twig--second"
          pathLength="1"
          d="M 814 112 C 770 48 694 34 608 58 M 710 232 C 634 234 568 286 508 354"></path>
        <rect class="botanical-mask__coverage" width="960" height="640" fill="white"></rect>
      </mask>
    </defs>

    <image
      data-botanical-image="right"
      width="960"
      height="640"
      preserveAspectRatio="xMidYMid meet"
      mask="url(#hero-branch-mask-right)"
    />
  </svg>

  <noscript>
    <img
      class="hero__branch hero__branch--left"
      src={defaultLeftBranch.src}
      width="960"
      height="640"
      alt=""
    />
    <img
      class="hero__branch hero__branch--right"
      src={defaultRightBranch.src}
      width="960"
      height="640"
      alt=""
    />
  </noscript>
</div>

<script is:inline define:vars={{ botanicalAssets }}>
  const botanicalReveal = document.querySelector('[data-botanical-reveal]');
  const leftBranch = botanicalReveal?.querySelector('[data-botanical-image="left"]');
  const rightBranch = botanicalReveal?.querySelector('[data-botanical-image="right"]');

  if (
    botanicalReveal instanceof HTMLElement &&
    leftBranch instanceof SVGImageElement &&
    rightBranch instanceof SVGImageElement
  ) {
    const resolveVariant = () =>
      document.documentElement.dataset.season === 'winter' ? 'winter' : 'default';

    const applyVariant = (variant) => {
      const assets = botanicalAssets[variant];
      leftBranch.setAttribute('href', assets.left);
      rightBranch.setAttribute('href', assets.right);
    };

    const preloadVariant = async (variant) => {
      const assets = botanicalAssets[variant];

      await Promise.all(
        Object.values(assets).map(async (src) => {
          const image = new Image();
          image.src = src;
          await image.decode();
        }),
      );
    };

    let activeVariant;
    let latestRequest = 0;

    const loadVariant = async (nextVariant) => {
      const request = ++latestRequest;

      if (nextVariant === activeVariant) return;

      try {
        await preloadVariant(nextVariant);
      } catch {
        if (botanicalReveal.classList.contains('hero__art--botanical-ready')) return;
      }

      if (request !== latestRequest || nextVariant !== resolveVariant()) return;

      applyVariant(nextVariant);
      activeVariant = nextVariant;
      botanicalReveal.classList.add('hero__art--botanical-ready');
    };

    const observer = new MutationObserver(() => {
      void loadVariant(resolveVariant());
    });

    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-season'],
    });

    void loadVariant(resolveVariant());
  }
</script>
