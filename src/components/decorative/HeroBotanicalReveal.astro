    [100, 460, 830, 'M 880 170 C 824 232 792 270 756 307 L 677 367'],
    [120, 460, 890, 'M 887 357 C 859 408 807 445 747 455 C 706 482 685 519 628 565'],
    [95, 410, 740, 'M 678 102 C 664 77 644 44 599 10'],
