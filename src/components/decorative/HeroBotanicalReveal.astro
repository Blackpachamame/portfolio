          pathLength="1"
          d="M 566 126 C 540 110 530 72 494 60"></path>
        <path
          class="botanical-mask__stroke botanical-mask__twig botanical-mask__twig--first botanical-mask__spring"
          pathLength="1"
          d="M 786 306 C 748 332 722 374 698 414 C 684 442 661 453 640 470 M 790 444 C 772 498 711 541 674 557 C 659 568 650 581 642 593"
        ></path>
