      900,
      'M 933 35 C 850 80 761 58 707 85 C 652 117 595 120 540 127 C 489 122 445 149 410 153',
    ],
    [126, 340, 760, 'M 716 82 C 673 65 620 41 535 42'],
    [95, 520, 790, 'M 580 113 C 554 91 533 54 477 26'],
