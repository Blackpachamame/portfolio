    [112, 460, 890, 'M 884 345 C 862 407 809 442 754 455 L 667 512'],
    [76, 390, 740, 'M 680 101 C 654 75 617 49 574 12'],
    [74, 620, 730, 'M 579 144 C 550 133 549 100 520 80'],
    [70, 680, 670, 'M 575 143 C 539 128 502 133 477 143'],
    [64, 610, 740, 'M 645 206 C 609 231 578 237 548 242'],
    [80, 690, 660, 'M 753 452 C 704 440 675 414 635 374'],
    [76, 780, 570, 'M 748 469 C 695 482 657 511 580 503'],
    [110, 750, 600, 'M 573 252 C 492 271 412 278 309 324'],
    [76, 850, 500, 'M 560 165 C 514 181 461 185 403 163'],
    [76, 700, 650, 'M 707 222 C 710 273 681 292 644 307'],
    [76, 800, 550, 'M 700 313 C 695 350 665 369 606 354'],
    [52, 850, 500, 'M 570 290 L 458 332'],
    [38, 850, 500, 'M 670 447 L 582 513'],
  ],
};
---

<div class="hero__art" aria-hidden="true" data-botanical-reveal>
  <svg
    class="hero__branch hero__branch--left botanical-reveal botanical-reveal--left"
    viewBox="0 0 960 640"
    width="960"
    height="640"
    focusable="false">
    <defs>
      <mask
        id="hero-branch-mask-left"
        x="0"
        y="0"
        width="960"
        height="640"
        maskUnits="userSpaceOnUse"
        maskContentUnits="userSpaceOnUse">
        <path
          class="botanical-mask__stroke botanical-mask__stem"
          pathLength="1"
          d="M -70 8 C 64 36 98 116 134 212 C 172 314 208 386 288 476"></path>
        <path
          class="botanical-mask__stroke botanical-mask__branch botanical-mask__branch--first"
          pathLength="1"
          d="M 0 32 C 116 70 210 56 310 82 C 402 106 454 148 550 176"></path>
        <path
          class="botanical-mask__stroke botanical-mask__branch botanical-mask__branch--second"
          pathLength="1"
          d="M 62 86 C 164 106 230 150 298 208 C 358 258 408 274 490 306"></path>
        <path
          class="botanical-mask__stroke botanical-mask__twig botanical-mask__twig--first"
          pathLength="1"
          d="M 112 126 C 72 220 52 294 94 374 C 120 422 162 454 228 512"></path>
        <path
          class="botanical-mask__stroke botanical-mask__twig botanical-mask__twig--second"
          pathLength="1"
          d="M 204 116 C 254 36 338 24 434 48 M 302 202 C 392 196 470 242 550 300"></path>
        <!-- Terminal twigs follow the Spring and Summer branches beyond the shared strokes. -->
        <path
          class="botanical-mask__stroke botanical-mask__branch botanical-mask__branch--second botanical-mask__spring botanical-mask__tip"
          pathLength="1"
          d="M 472 130 C 520 160 579 190 639 189"></path>
        <path
          class="botanical-mask__stroke botanical-mask__twig botanical-mask__twig--first botanical-mask__spring"
          pathLength="1"
          d="M 210 484 C 248 537 269 564 298 571"></path>
        <path
          class="botanical-mask__stroke botanical-mask__twig botanical-mask__twig--first botanical-mask__summer"
          pathLength="1"
          d="M 210 490 C 254 535 266 567 300 591"></path>
        <path
          class="botanical-mask__stroke botanical-mask__twig botanical-mask__twig--first botanical-mask__summer botanical-mask__tip"
          pathLength="1"
          d="M 552 169 C 585 177 612 194 633 216"></path>
        <rect class="botanical-mask__coverage" width="960" height="640" fill="white"></rect>
      </mask>
    </defs>

    <image
      data-botanical-image="left"
      width="960"
      height="640"
      preserveAspectRatio="xMidYMid meet"
      mask="url(#hero-branch-mask-left)"
