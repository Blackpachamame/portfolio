---
import { getImage } from 'astro:assets';

import autumnBranchLeft from '../../assets/seasonal/autumn/branch-left.png';
import autumnBranchRight from '../../assets/seasonal/autumn/branch-right.png';
import defaultBranchLeft from '../../assets/seasonal/default/branch-left.png';
import defaultBranchRight from '../../assets/seasonal/default/branch-right.png';
import springBranchLeft from '../../assets/seasonal/spring/branch-left.png';
import springBranchRight from '../../assets/seasonal/spring/branch-right.png';
import summerBranchLeft from '../../assets/seasonal/summer/branch-left.png';
import summerBranchRight from '../../assets/seasonal/summer/branch-right.png';
import winterBranchLeft from '../../assets/seasonal/winter/branch-left.png';
import winterBranchRight from '../../assets/seasonal/winter/branch-right.png';

const [
  defaultLeftBranch,
  defaultRightBranch,
  autumnLeftBranch,
  autumnRightBranch,
  springLeftBranch,
  springRightBranch,
  summerLeftBranch,
  summerRightBranch,
  winterLeftBranch,
  winterRightBranch,
] = await Promise.all([
  getImage({ src: defaultBranchLeft, width: 960, format: 'webp', quality: 82 }),
  getImage({ src: defaultBranchRight, width: 960, format: 'webp', quality: 82 }),
  getImage({ src: autumnBranchLeft, width: 960, format: 'webp', quality: 82 }),
  getImage({ src: autumnBranchRight, width: 960, format: 'webp', quality: 82 }),
  getImage({ src: springBranchLeft, width: 960, format: 'webp', quality: 82 }),
  getImage({ src: springBranchRight, width: 960, format: 'webp', quality: 82 }),
  getImage({ src: summerBranchLeft, width: 960, format: 'webp', quality: 82 }),
  getImage({ src: summerBranchRight, width: 960, format: 'webp', quality: 82 }),
  getImage({ src: winterBranchLeft, width: 960, format: 'webp', quality: 82 }),
  getImage({ src: winterBranchRight, width: 960, format: 'webp', quality: 82 }),
]);

const botanicalAssets = {
  default: {
    left: defaultLeftBranch.src,
    right: defaultRightBranch.src,
  },
  autumn: {
    left: autumnLeftBranch.src,
    right: autumnRightBranch.src,
  },
  spring: {
    left: springLeftBranch.src,
    right: springRightBranch.src,
  },
  summer: {
    left: summerLeftBranch.src,
    right: summerRightBranch.src,
  },
  winter: {
    left: winterLeftBranch.src,
    right: winterRightBranch.src,
  },
};
// Per right raster: [stroke width, draw start, draw duration, trunk-to-tip path].
// These ribbons include the foliage along each branch; mobile needs no coverage rect.
const mobileMasks: Record<string, [number, number, number, string][]> = {
  autumn: [
    [150, 0, 650, 'M 1000 -25 C 920 50 875 150 880 285 C 880 420 905 525 940 620'],
    [130, 170, 850, 'M 930 50 C 815 95 745 83 672 103 C 616 133 573 155 520 187 L 459 239'],
    [
      112,
      270,
      850,
      'M 895 90 C 814 133 741 157 689 185 C 643 224 620 255 610 279 L 548 332 L 477 378',
