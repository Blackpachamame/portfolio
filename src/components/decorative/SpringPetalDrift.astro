<template data-spring-petal-template>
  <div class="spring-petal-drift" aria-hidden="true" data-spring-petal-drift>
    <span class="spring-petal-drift__petal"></span>
    <span class="spring-petal-drift__petal"></span>
    <span class="spring-petal-drift__petal"></span>
    <span class="spring-petal-drift__petal"></span>
    <span class="spring-petal-drift__petal"></span>
    <span class="spring-petal-drift__petal"></span>
    <span class="spring-petal-drift__petal"></span>
    <span class="spring-petal-drift__petal"></span>
    <span class="spring-petal-drift__petal"></span>
    <span class="spring-petal-drift__petal" data-spring-petal-final></span>
  </div>
</template>

<script>
  const hero = document.querySelector('.hero');
  const seasonSelector = document.querySelector('[data-season-selector]');
  const botanicalReveal = document.querySelector('[data-botanical-reveal]');
  const petalTemplate = document.querySelector('[data-spring-petal-template]');

  if (
    hero instanceof HTMLElement &&
    seasonSelector instanceof HTMLSelectElement &&
    botanicalReveal instanceof HTMLElement &&
    petalTemplate instanceof HTMLTemplateElement
  ) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let previousSeason = document.documentElement.dataset.season ?? 'default';
    let activeEffect: HTMLElement | undefined;
    let pendingEffect = false;

    const stopEffect = () => {
      pendingEffect = false;
      activeEffect?.remove();
      activeEffect = undefined;
    };

    const startEffect = () => {
      stopEffect();

      if (reducedMotion.matches) return;

      const effect = petalTemplate.content.firstElementChild?.cloneNode(true);

      if (!(effect instanceof HTMLElement)) return;

      const finalPetal = effect.querySelector('[data-spring-petal-final]');

      if (!(finalPetal instanceof HTMLElement)) return;

      activeEffect = effect;
      finalPetal.addEventListener(
        'animationend',
        () => {
          if (activeEffect === effect) stopEffect();
        },
        { once: true },
      );
      hero.append(effect);
    };

    seasonSelector.addEventListener('change', () => {
      const nextSeason = seasonSelector.value;

      if (nextSeason !== 'spring') {
        stopEffect();
      } else if (previousSeason !== 'spring') {
        pendingEffect =
          !reducedMotion.matches && botanicalReveal.dataset.botanicalVariant !== 'spring';
      }

      previousSeason = nextSeason;
    });

    // This mutation is delivered after the synchronous botanical swap and ready/replay cycle.
    const botanicalObserver = new MutationObserver(() => {
      if (
        !pendingEffect ||
        reducedMotion.matches ||
        seasonSelector.value !== 'spring' ||
        document.documentElement.dataset.season !== 'spring' ||
        botanicalReveal.dataset.botanicalVariant !== 'spring' ||
        !botanicalReveal.classList.contains('hero__art--botanical-ready')
      ) {
        return;
      }

      startEffect();
    });

    botanicalObserver.observe(botanicalReveal, {
      attributes: true,
      attributeFilter: ['data-botanical-variant'],
    });

    reducedMotion.addEventListener('change', (event) => {
      if (event.matches) stopEffect();
    });
  }
</script>
