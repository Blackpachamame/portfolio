---
interface Props {
  headingId: string;
  eyebrow: string;
  title: string;
  introduction?: string;
}

const { headingId, eyebrow, title, introduction } = Astro.props;
---

<header class="section-heading">
  <p class="section-heading__eyebrow">{eyebrow}</p>
  <h2 id={headingId}>{title}</h2>
  {introduction && <p class="section-heading__introduction">{introduction}</p>}
</header>
