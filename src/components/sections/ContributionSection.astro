---
import { contributionAreas } from '../../data/site';
---

<section id="aportes" class="contribution-section landing-section" aria-labelledby="aportes-title">
  <div class="contribution-section__inner container">
    <header class="contribution-section__heading">
      <div class="contribution-section__index">
        <p>04 — Aportes</p>
        <span aria-hidden="true"></span>
      </div>
      <h2 id="aportes-title">Aportes concretos para construir y mejorar productos frontend.</h2>
      <p class="contribution-section__introduction">
        Puedo integrarme a tareas de implementación, mantenimiento y mejora progresiva, trabajando
        junto a diseño, backend y perfiles con mayor experiencia.
      </p>
    </header>

    <ol class="contribution-list" role="list">
      {
        contributionAreas.map((area, index) => (
          <li>
            <span class="contribution-list__number" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <div class="contribution-list__content">
              <h3>{area.title}</h3>
              <p>{area.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
