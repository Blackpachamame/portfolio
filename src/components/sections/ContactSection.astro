---
import { contactContent, siteInfo, socialLinks } from '../../data/site';

const emailHref = `mailto:${siteInfo.email}`;
---

<section id="contacto" class="landing-section contact-section" aria-labelledby="contacto-title">
  <div class="contact-section__inner container">
    <header class="contact-section__heading">
      <div class="contact-section__index">
        <p>{contactContent.eyebrow}</p>
        <span aria-hidden="true"></span>
      </div>
      <h2 id="contacto-title">{contactContent.title}</h2>
      <p class="contact-section__introduction">{contactContent.description}</p>
      <a class="button-link contact-section__primary-action" href={emailHref}>
        {contactContent.primaryAction}
      </a>
    </header>

    <div class="contact-details">
      <div class="contact-details__item contact-details__item--availability">
        <p class="contact-details__label">{contactContent.availabilityLabel}</p>
        <p>{contactContent.availability}</p>
      </div>

      <address class="contact-details__address">
        <div class="contact-details__item">
          <p class="contact-details__label">Ubicación</p>
          <p>{siteInfo.location}</p>
        </div>

        <div class="contact-details__item">
          <p class="contact-details__label">Correo</p>
          <a class="contact-details__email" href={emailHref}>{siteInfo.email}</a>
        </div>

        <div class="contact-details__item">
          <p class="contact-details__label">Perfiles profesionales</p>
          <ul class="contact-details__links" role="list">
            {
              socialLinks.map((link) => (
                <li>
                  <a href={link.href} target="_blank" rel="noopener noreferrer">
                    {link.platform}
                    <span aria-hidden="true"> ↗</span>
                    <span class="contact-details__new-tab">(abre en una pestaña nueva)</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </address>
    </div>
  </div>
</section>
