---
import { secondaryCollaborations } from '../../data/collaborations';
---

<section
  id="colaboraciones"
  class="collaborations-section landing-section"
  aria-labelledby="colaboraciones-title">
  <div class="collaborations-section__inner container">
    <header class="collaborations-section__heading">
      <div class="collaborations-section__index">
        <p>05 — Colaboraciones</p>
        <span aria-hidden="true"></span>
      </div>
      <h2 id="colaboraciones-title">Participaciones complementarias en productos y sitios web.</h2>
      <p class="collaborations-section__introduction">
        Colaboraciones puntuales donde contribuí con mejoras frontend, mantenimiento técnico y
        ajustes de calidad sobre proyectos existentes.
      </p>
    </header>

    <div class="collaborations-list">
      {
        secondaryCollaborations.map((collaboration) => (
          <article class="collaboration-entry">
            <dl class="collaboration-entry__meta">
              <div>
                <dt>Categoría</dt>
                <dd>{collaboration.category}</dd>
              </div>
              <div>
                <dt>Período</dt>
                <dd>{collaboration.period}</dd>
              </div>
            </dl>

            <div class="collaboration-entry__content">
              <header class="collaboration-entry__header">
                <p>{collaboration.role}</p>
                <h3>{collaboration.name}</h3>
              </header>

              <p class="collaboration-entry__description">{collaboration.description}</p>

              <div class="collaboration-entry__contributions">
                <h4>Aportes concretos</h4>
                <ul>
                  {collaboration.contributions.map((contribution) => (
                    <li>{contribution}</li>
                  ))}
                </ul>
              </div>

              <a
                class="collaboration-entry__link"
                href={collaboration.link.href}
                target="_blank"
                rel="noopener noreferrer">
                {collaboration.link.label}
                <span aria-hidden="true"> ↗</span>
                <span class="collaboration-entry__new-tab">(abre en una pestaña nueva)</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
