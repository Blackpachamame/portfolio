---
import { experiences } from '../../data/experience';
---

<section
  id="experiencia"
  class="experience-section landing-section"
  aria-labelledby="experiencia-title">
  <div class="container">
    <header class="experience-section__heading">
      <div class="experience-section__index">
        <p>02 — Experiencia</p>
        <span aria-hidden="true"></span>
      </div>
      <h2 id="experiencia-title">Trabajo en equipo, proyectos reales y aprendizaje aplicado.</h2>
    </header>

    <ol class="experience-list" role="list">
      {
        experiences.map((experience) => (
          <li
            class:list={[
              'experience-list__item',
              {
                'experience-list__item--featured': experience.type === 'Experiencia en equipo',
                'experience-list__item--simulation': experience.type === 'Simulación laboral',
                'experience-list__item--brief': experience.type === 'Proyecto puntual',
              },
            ]}>
            <article class="experience-entry">
              <dl class="experience-entry__meta">
                <div>
                  <dt>Período</dt>
                  <dd>{experience.period}</dd>
                </div>
                <div>
                  <dt>Tipo</dt>
                  <dd class="experience-entry__type">{experience.type}</dd>
                </div>
                <div>
                  <dt>Modalidad</dt>
                  <dd>{experience.modality}</dd>
                </div>
              </dl>

              <div class="experience-entry__content">
                <header class="experience-entry__header">
                  <p class="experience-entry__role">{experience.role}</p>
                  <h3>{experience.organization}</h3>
                </header>

                <p class="experience-entry__summary">{experience.summary}</p>

                <div class="experience-entry__contributions">
                  <h4>Aportes concretos</h4>
                  <ul>
                    {experience.contributions.map((contribution) => (
                      <li>{contribution}</li>
                    ))}
                  </ul>
                </div>

                <div class="experience-entry__technologies">
                  <p>Tecnologías</p>
                  <ul>
                    {experience.technologies.map((technology) => (
                      <li>{technology}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </article>
          </li>
        ))
      }
    </ol>
  </div>
</section>
