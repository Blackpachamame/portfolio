---
import SectionHeading from '../ui/SectionHeading.astro';
import { featuredProjects } from '../../data/projects';
---

<section id="proyectos" class="landing-section" aria-labelledby="proyectos-title">
  <div class="container">
    <SectionHeading
      headingId="proyectos-title"
      eyebrow="Proyectos destacados"
      title="Productos reales desarrollados en equipo"
      introduction="Mi rol y mis aportes se presentan por separado del trabajo asumido por otros integrantes."
    />

    <div class="entry-list">
      {
        featuredProjects.map((project) => (
          <article class="entry project-entry">
            <header class="entry__header">
              <div>
                <h3>{project.name}</h3>
                <p class="entry__role">{project.role}</p>
              </div>
              <p class="entry__period">{project.period}</p>
            </header>

            <p class="entry__meta">{project.type}</p>
            <p>{project.description}</p>

            <div>
              <h4>Aportes principales</h4>
              <ul class="detail-list">
                {project.contributions.map((contribution) => (
                  <li>{contribution}</li>
                ))}
              </ul>
            </div>

            <ul class="tag-list" aria-label={`Tecnologías utilizadas en ${project.name}`}>
              {project.technologies.map((technology) => (
                <li>{technology}</li>
              ))}
            </ul>

            <div class="entry__footer">
              <a
                class="text-link"
                href={project.liveLink.href}
                target="_blank"
                rel="noopener noreferrer">
                {project.liveLink.label}
                <span aria-hidden="true"> ↗</span>
              </a>
              <p>
                Repositorio {project.repositoryVisibility.toLowerCase()} · Caso de estudio en
                preparación
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
