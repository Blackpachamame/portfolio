---
import { Image } from 'astro:assets';
import { projects } from '../../data/projects';

const featuredProjects = projects.filter((project) => project.level === 'Destacado');
const secondaryProjects = projects.filter((project) => project.level === 'Secundario');
---

<section id="proyectos" class="landing-section" aria-labelledby="proyectos-title">
  <div class="projects-section__inner container">
    <header class="projects-section__heading">
      <div class="projects-section__index">
        <p>03 — Proyectos</p>
        <span aria-hidden="true"></span>
      </div>
      <h2 id="proyectos-title">
        Productos publicados y proyectos con desafíos frontend concretos.
      </h2>
      <p class="projects-section__introduction">
        Una selección de productos propios, colaboraciones y proyectos de aprendizaje donde trabajé
        en interfaces, estado, integración con APIs y experiencia responsive.
      </p>
    </header>

    <div class="projects-featured">
      {
        featuredProjects.map((project) => (
          <article class="project-card project-card--featured">
            <div class="project-card__media">
              <Image
                src={project.image}
                alt={project.imageAlt}
                widths={[640, 960, 1280]}
                sizes="(min-width: 1024px) 544px, calc(100vw - 32px)"
                loading="lazy"
              />
            </div>

            <div class="project-card__content">
              <header class="project-card__header">
                <p class="project-card__category">{project.category}</p>
                <h3>{project.name}</h3>
                <p class="project-card__role">{project.role}</p>
              </header>

              <p class="project-card__description">{project.description}</p>

              <div class="project-card__contributions">
                <h4>Aportes concretos</h4>
                <ul>
                  {project.contributions?.map((contribution) => (
                    <li>{contribution}</li>
                  ))}
                </ul>
              </div>

              <ul
                class="project-card__technologies"
                aria-label={`Tecnologías utilizadas en ${project.name}`}>
                {project.technologies.map((technology) => (
                  <li>{technology}</li>
                ))}
              </ul>

              <a
                class="project-card__link"
                href={project.primaryLink.href}
                target="_blank"
                rel="noopener noreferrer">
                {project.primaryLink.label}
                <span aria-hidden="true"> ↗</span>
                <span class="project-card__new-tab">(abre en una pestaña nueva)</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <section class="projects-secondary" aria-labelledby="otros-proyectos-title">
      <header class="projects-secondary__heading">
        <p>Selección complementaria</p>
        <h3 id="otros-proyectos-title">Otros proyectos</h3>
      </header>

      <div class="projects-secondary__grid">
        {
          secondaryProjects.map((project) => (
            <article class="project-card project-card--secondary">
              <div class="project-card__media">
                <Image
                  src={project.image}
                  alt={project.imageAlt}
                  widths={[480, 720, 960]}
                  sizes="(min-width: 768px) 528px, calc(100vw - 32px)"
                  loading="lazy"
                />
              </div>

              <div class="project-card__content">
                <header class="project-card__header">
                  <p class="project-card__category">{project.category}</p>
                  <h4>{project.name}</h4>
                </header>

                <p class="project-card__description">{project.description}</p>

                <ul
                  class="project-card__technologies"
                  aria-label={`Tecnologías utilizadas en ${project.name}`}>
                  {project.technologies.map((technology) => (
                    <li>{technology}</li>
                  ))}
                </ul>

                <a
                  class="project-card__link"
                  href={project.primaryLink.href}
                  target="_blank"
                  rel="noopener noreferrer">
                  {project.primaryLink.label}
                  <span aria-hidden="true"> ↗</span>
                  <span class="project-card__new-tab">(abre en una pestaña nueva)</span>
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </div>
</section>
