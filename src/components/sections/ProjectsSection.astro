---
import { Image } from 'astro:assets';
import { projects } from '../../data/projects';

const featuredProjects = projects.filter((project) => project.level === 'Destacado');
const secondaryProjects = projects.filter((project) => project.level === 'Secundario');
---

<section id="proyectos" class="projects-section landing-section" aria-labelledby="proyectos-title">
  <div class="projects-section__inner container">
    <header class="projects-section__heading">
      <div class="projects-section__index">
        <p>03 — Proyectos</p>
        <span aria-hidden="true"></span>
      </div>
      <h2 id="proyectos-title">Productos donde trabajé sobre problemas reales de frontend.</h2>
      <p class="projects-section__introduction">
        Dos productos en equipo y dos proyectos complementarios donde participé en interfaces,
        estado, integración de APIs y experiencia responsive.
      </p>
    </header>

    <div class="project-features">
      {
        featuredProjects.map((project, index) => (
          <article
            class:list={['project-feature', { 'project-feature--reverse': index % 2 !== 0 }]}>
            <div class="project-feature__content">
              <header class="project-feature__header">
                <div class="project-feature__eyebrow">
                  <p class="project-feature__index">{String(index + 1).padStart(2, '0')}</p>
                  <p class="project-feature__meta">
                    <span>{project.category}</span>
                    <span aria-hidden="true">·</span>
                    <span>{project.role}</span>
                  </p>
                </div>
                <h3>{project.name}</h3>
              </header>

              <p class="project-feature__description">{project.description}</p>

              <div class="project-feature__contributions">
                <h4>Aportes seleccionados</h4>
                <ul>
                  {project.contributions?.map((contribution) => (
                    <li>{contribution}</li>
                  ))}
                </ul>
              </div>

              <div class="project-stack">
                <p>Stack</p>
                <ul aria-label={`Tecnologías utilizadas en ${project.name}`}>
                  {project.technologies.map((technology) => (
                    <li>{technology}</li>
                  ))}
                </ul>
              </div>

              <a
                class="project-link"
                href={project.primaryLink.href}
                target="_blank"
                rel="noopener noreferrer">
                {project.primaryLink.label}
                <span aria-hidden="true"> ↗</span>
                <span class="project-link__new-tab">(abre en una pestaña nueva)</span>
              </a>
            </div>

            <div class="project-feature__media project-media">
              <Image
                src={project.image}
                alt={project.imageAlt}
                widths={[640, 960, 1280]}
                sizes="(min-width: 1280px) 605px, (min-width: 1024px) calc(54vw - 58px), calc(100vw - 32px)"
                loading="lazy"
              />
            </div>
          </article>
        ))
      }
    </div>

    <section class="projects-secondary" aria-labelledby="otros-proyectos-title">
      <header class="projects-secondary__heading">
        <p>Selección complementaria</p>
        <h3 id="otros-proyectos-title">Otros proyectos</h3>
      </header>

      <div class="projects-secondary__grid">
        {
          secondaryProjects.map((project) => (
            <article class="project-secondary">
              <div class="project-secondary__media project-media">
                <Image
                  src={project.image}
                  alt={project.imageAlt}
                  widths={[480, 720, 960]}
                  sizes="(min-width: 1200px) 560px, (min-width: 768px) calc(50vw - 48px), calc(100vw - 32px)"
                  loading="lazy"
                />
              </div>

              <div class="project-secondary__content">
                <header class="project-secondary__header">
                  <p class="project-secondary__meta">
                    <span>{project.category}</span>
                    <span aria-hidden="true">·</span>
                    <span>{project.role}</span>
                  </p>
                  <h4>{project.name}</h4>
                </header>

                <p class="project-secondary__description">{project.description}</p>

                <div class="project-stack">
                  <p>Stack</p>
                  <ul aria-label={`Tecnologías utilizadas en ${project.name}`}>
                    {project.technologies.map((technology) => (
                      <li>{technology}</li>
                    ))}
                  </ul>
                </div>

                <a
                  class="project-link"
                  href={project.primaryLink.href}
                  target="_blank"
                  rel="noopener noreferrer">
                  {project.primaryLink.label}
                  <span aria-hidden="true"> ↗</span>
                  <span class="project-link__new-tab">(abre en una pestaña nueva)</span>
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </div>
</section>
