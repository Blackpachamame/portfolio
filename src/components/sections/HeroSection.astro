---
import { Image } from 'astro:assets';

import branchLeft from '../../assets/seasonal/default/branch-left.png';
import branchRight from '../../assets/seasonal/default/branch-right.png';
import { heroContent } from '../../data/site';
---

<section id="inicio" class="hero" aria-labelledby="hero-title">
  <div class="hero__art" aria-hidden="true">
    <Image
      class="hero__branch hero__branch--left"
      src={branchLeft}
      alt=""
      width={960}
      format="webp"
      quality={82}
      loading="eager"
      decoding="sync"
    />
    <Image
      class="hero__branch hero__branch--right"
      src={branchRight}
      alt=""
      width={960}
      format="webp"
      quality={82}
      loading="eager"
      decoding="sync"
    />
  </div>

  <div class="hero__inner container">
    <div class="hero__main">
      <h1 id="hero-title">
        {heroContent.titleLines.map((line) => <span>{line}</span>)}
      </h1>
      <p class="hero__introduction">{heroContent.introduction}</p>
      <div class="hero__actions" role="group" aria-label="Acciones principales">
        <a class="button-link" href="#proyectos">Ver proyectos</a>
        <a class="button-link button-link--secondary" href="#experiencia">Ver experiencia</a>
      </div>
    </div>

    <aside class="hero__summary" aria-label="Resumen profesional">
      <ul class="hero__highlights" aria-label="Información destacada" role="list">
        {heroContent.highlights.map((highlight) => <li>{highlight}</li>)}
      </ul>
    </aside>
  </div>
</section>
