---
import { heroContent, siteInfo } from '../../data/site';
---

<section id="inicio" class="hero" aria-labelledby="hero-title">
  <div class="hero__content container">
    <p class="hero__eyebrow">{heroContent.eyebrow}</p>
    <h1 id="hero-title">{siteInfo.name}</h1>
    <p class="hero__role">{siteInfo.role}</p>
    <p class="hero__introduction">{heroContent.introduction}</p>
    <div class="hero__actions">
      <a class="button-link" href="#proyectos">Ver proyectos destacados</a>
      <a class="text-link" href="#contacto">Ir a contacto</a>
    </div>
  </div>
</section>
