---
import SectionHeading from '../ui/SectionHeading.astro';
import { skillGroups } from '../../data/skills';
---

<section id="stack" class="landing-section" aria-labelledby="stack-title">
  <div class="container">
    <SectionHeading
      headingId="stack-title"
      eyebrow="Stack técnico"
      title="Tecnologías principales y complementarias"
      introduction="La separación refleja el peso de cada grupo dentro de mi perfil; no representa porcentajes ni niveles artificiales."
    />

    <div class="skill-groups">
      {
        skillGroups.map((group, index) => (
          <article class:list={['skill-group', { 'skill-group--secondary': index > 0 }]}>
            <h3>{group.title}</h3>
            <p>{group.description}</p>
            <ul class="tag-list" role="list">
              {group.skills.map((skill) => (
                <li>{skill.name}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
